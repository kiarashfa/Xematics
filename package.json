{
  "name": "xematics",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @xematics/web dev",
    "build": "pnpm --filter @xematics/web build",
    "lint": "eslint .",
    "format": "prettier --write . !pnpm-lock.yaml",
    "format:check": "prettier --check . !pnpm-lock.yaml",
    "typecheck": "tsc -p scripts && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:update": "pnpm --filter @xematics/core exec vitest run --update",
    "test:e2e": "pnpm --filter @xematics/web test:e2e",
    "check:text": "node scripts/check-public-text.ts",
    "check:leaks": "node scripts/check-build-leaks.ts",
    "check:tikz": "node scripts/check-tikz.ts",
    "check:budgets": "node scripts/check-budgets.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm check:budgets && pnpm check:text && pnpm check:leaks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/eb-garamond": "5.3.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.23.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
