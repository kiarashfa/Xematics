---
// The wordmark is generated by scripts/build-brand.ts; this wrapper inlines it so it follows the theme.
import svg from '../assets/wordmark.svg?raw';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['wordmark-box', className]} aria-hidden="true" set:html={svg} />

<style>
  .wordmark-box {
    display: inline-flex;
  }
</style>
