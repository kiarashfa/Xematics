---
import { SITE } from '../site.config.ts';
import ProfileMenu from './ProfileMenu.astro';
import ThemeToggle from './ThemeToggle.astro';
import Wordmark from './Wordmark.astro';
import pkg from '../../package.json';

const base = import.meta.env.BASE_URL;
const links = [
  { href: base, label: 'Home' },
  { href: `${base}tool/`, label: 'Editor' },
  { href: `${base}examples/`, label: 'Examples' },
  { href: `${base}guide/`, label: 'Guide' },
  { href: `${base}about/`, label: 'About' },
];
// The edition mark follows the major version, like a journal volume: 1.x is Vol. I.
const ROMAN = ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const volume = ROMAN[Number(pkg.version.split('.')[0])] ?? pkg.version.split('.')[0];
---

<header class="masthead">
  <div class="page top">
    <!-- Today's date, written by the script below in the visitor's own time zone. -->
    <p class="meta">
      <time class="today" data-today></time>
    </p>
    <a class="brand" href={base} aria-label={`${SITE.name} home`}>
      <Wordmark />
    </a>
    <div class="actions">
      <span class="meta edition">Vol. {volume} · Free and private</span>
      <ThemeToggle />
      <ProfileMenu />
    </div>
  </div>
  <nav class="page links" aria-label="Main">
    {links.map((link) => (
      <a
        class="label-caps"
        href={link.href}
        aria-current={link.href === Astro.url.pathname ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 20px 14px;
  }

  .meta {
    margin: 0;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--muted);
  }

  .meta.edition {
    font-size: 0.75rem;
    font-style: normal;
    letter-spacing: 0.08em;
  }

  .brand {
    justify-self: center;
    display: inline-flex;
    color: var(--ink);
  }

  .brand :global(.wordmark) {
    height: 34px;
    width: auto;
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 34px;
    padding-block: 8px;
    border-top: 1px solid var(--ink);
    border-bottom: 3px double var(--ink);
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .top {
      grid-template-columns: 1fr auto;
    }

    .meta {
      display: none;
    }

    .brand {
      justify-self: start;
    }

    .brand :global(.wordmark) {
      height: 28px;
    }

    .links {
      justify-content: flex-start;
      gap: 22px;
    }
  }
</style>

<script>
  // A dateline like a newspaper's: today's date in English, in the visitor's preferred English.
  const locale = navigator.languages.find((l) => l.toLowerCase().startsWith('en')) ?? 'en-GB';
  const now = new Date();
  for (const node of document.querySelectorAll<HTMLTimeElement>('[data-today]')) {
    node.dateTime = now.toISOString().slice(0, 10);
    node.textContent = now.toLocaleDateString(locale, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }
</script>
