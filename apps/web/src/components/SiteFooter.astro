---
// One row, like the foot of a journal page: the links and the copyright.
import { SITE } from '../site.config.ts';

const base = import.meta.env.BASE_URL;

// The first year is fixed (when the project began); the last is read at build time, so each
// deploy shows the right range without editing: 2026, then 2026–2027.
const START_YEAR = 2026;
const buildYear = new Date().getFullYear();
const years = buildYear > START_YEAR ? `${START_YEAR}–${buildYear}` : `${START_YEAR}`;
---

<footer class="colophon">
  <div class="page">
    <div class="bar">
      <nav aria-label="Footer">
        <a class="label-caps" href={`${base}about/#privacy`}>
          Privacy
        </a>
        <button type="button" class="label-caps settings" data-consent-open>
          Cookie settings
        </button>
        <a class="label-caps" href={`${base}credits/`}>
          Credits
        </a>
        <a class="label-caps" href={`${SITE.repoUrl}/blob/main/LICENSE`}>
          License
        </a>
        <a class="label-caps" href={SITE.repoUrl}>
          Source
        </a>
      </nav>
      <p class="copy">© {years} Kiarash Farajzadehahary</p>
    </div>
  </div>
</footer>

<style>
  .colophon {
    margin-top: 72px;
    padding-block: 0 32px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 12px;
    border-top: 3px double var(--ink);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 22px;
  }

  nav a,
  .settings {
    color: var(--muted);
    text-decoration: none;
  }

  .settings {
    min-height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  nav a:hover,
  .settings:hover {
    color: var(--ink);
  }

  .copy {
    margin: 0;
  }
</style>
