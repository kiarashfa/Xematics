---
import { EXAMPLES } from '../examples.ts';
import { editorLink, figure, sourceSummary } from '../figures.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config.ts';

// Figures are rendered at build time by the same engine as the editor.
const base = import.meta.env.BASE_URL;
const hero = await figure('784-16-16-10', 'hero-');
const plates = await Promise.all(
  ['perceptron', 'xor', 'mnist', 'cnn'].map(async (slug, i) => {
    const example = EXAMPLES.find((e) => e.slug === slug)!;
    return {
      ...example,
      numeral: ['I', 'II', 'III', 'IV'][i],
      svg: await figure(example.source, `plate${i + 1}-`),
      link: await editorLink(example.source),
      summary: sourceSummary(example.source),
    };
  }),
);

const highlights = [
  {
    title: 'Text in, figure out',
    text: 'Type a shorthand like 784-16-10, or YAML with layer names and options.',
  },
  {
    title: 'Made for print',
    text: 'Text is converted to outlines, so figures look identical in every viewer and editor.',
  },
  {
    title: 'Private by design',
    text: 'No account and no server storage. Everything runs in your browser.',
  },
];
---

<BaseLayout
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Xematics',
    url: `${SITE.url}${base}`,
    description:
      'Free neural network diagram generator: write the architecture as text and export publication-quality SVG, PNG, PDF or TikZ.',
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any (runs in a web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  }}
>
  <section class="page hero">
    <div class="copy">
      <p class="kicker">A diagram tool for researchers</p>
      <h1>
        Neural network figures, <em>typeset</em> for print.
      </h1>
      <p class="lead">
        Write the architecture as text, choose a style, and export vector figures that drop straight
        into your paper, thesis or slides. No account, nothing uploaded.
      </p>
      <div class="status">
        <p>
          Five styles, math and right-to-left labels, and export to SVG, PNG, PDF or TikZ for LaTeX.
          Free, and it works offline once loaded.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={`${base}tool/`}>
            Open the editor
          </a>
          <a class="btn" href={`${base}guide/`}>
            Read the guide
          </a>
        </div>
      </div>
    </div>
    <figure class="hero-figure">
      <div class="paper" set:html={hero} />
      <figcaption>
        <strong>Figure 1.</strong> A 784-16-16-10 multilayer perceptron, rendered by Xematics in the
        Classic style.
      </figcaption>
    </figure>
  </section>

  <section class="page highlights" aria-labelledby="highlights-title">
    <h2 id="highlights-title" class="sr-only">
      Highlights
    </h2>
    {highlights.map((item, i) => (
      <div class="highlight">
        <span class="section-mark">§ {i + 1}</span>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </div>
    ))}
  </section>

  <section class="page plates" id="examples" aria-labelledby="plates-title">
    <div class="plates-head">
      <h2 id="plates-title" class="label-caps">
        Plates
      </h2>
      <a class="label-caps" href={`${base}examples/`}>
        All twelve examples
      </a>
    </div>
    <div class="plate-grid">
      {plates.map((plate) => (
        <figure class="plate">
          <a
            class="paper"
            href={plate.link}
            aria-label={`Open ${plate.title} in the editor`}
            set:html={plate.svg}
          />
          <figcaption>
            <em>Plate {plate.numeral}.</em> {plate.title} <code>{plate.summary}</code>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 56px;
    align-items: center;
    padding-block: 56px 44px;
  }

  h1 {
    margin: 0 0 18px;
    font-size: clamp(2.3rem, 4.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.02em;
  }

  h1 em {
    color: var(--accent);
  }

  .status {
    margin-top: 26px;
    padding: 14px 18px;
    border-left: 2px solid var(--accent);
    background: var(--surface);
  }

  .status p {
    margin: 0 0 12px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-figure {
    margin: 0;
  }

  .hero-figure .paper {
    padding: 22px;
  }

  figcaption {
    margin-top: 10px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .hero-figure figcaption {
    padding-left: 10px;
    border-left: 2px solid var(--accent);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }

  .highlight {
    padding: 0 26px;
    border-left: 1px solid var(--line);
  }

  .highlight:first-of-type {
    padding-left: 0;
    border-left: 0;
  }

  .section-mark {
    font-size: 1.3rem;
    font-style: italic;
    color: var(--accent);
  }

  .highlight h3 {
    margin: 6px 0;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .highlight p {
    margin: 0;
    color: var(--muted);
  }

  .plates {
    padding-top: 52px;
  }

  .plates-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 0 18px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }

  .plates h2 {
    margin: 0;
    font-size: 0.85rem;
  }

  .plates-head a {
    font-size: 0.75rem;
  }

  .plate a.paper {
    display: grid;
    place-items: center;
  }

  .plate-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .plate {
    margin: 0;
  }

  .plate .paper {
    height: 150px;
    padding: 10px;
  }

  .plate .paper :global(svg) {
    max-height: 130px;
    width: auto;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 32px;
    }

    .highlights {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .highlight,
    .highlight:first-of-type {
      padding: 14px 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .plate-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
