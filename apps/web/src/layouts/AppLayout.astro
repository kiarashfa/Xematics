---
// Full-window layout for the editor: no site header or footer, no page scrolling.
import ConsentBar from '../components/ConsentBar.astro';
import Head, { type Props as HeadProps } from '../components/Head.astro';

type Props = HeadProps;
---

<!doctype html>
<html lang="en" class="app">
  <head>
    <Head {...Astro.props} />
  </head>
  <body>
    <slot />
    <ConsentBar />
  </body>
</html>

<style is:global>
  html.app,
  html.app body {
    height: 100%;
    overflow: hidden;
  }
</style>
