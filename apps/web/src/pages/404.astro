---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found" noindex>
  <section class="page notfound">
    <p class="kicker">Error 404</p>
    <h1>This page is not in the index.</h1>
    <p class="lead">The address may be mistyped, or the page may have moved.</p>
    <a class="btn btn-primary" href={base}>
      Back to the front page
    </a>
  </section>
  <script is:inline define:vars={{ base }}>
    // GitHub Pages paths are case-sensitive: send /xematics/... to /Xematics/...
    const path = location.pathname;
    if (!path.startsWith(base) && path.toLowerCase().startsWith(base.toLowerCase())) {
      location.replace(base + path.slice(base.length) + location.search + location.hash);
    }
  </script>
</BaseLayout>

<style>
  .notfound {
    padding-block: 80px 40px;
    text-align: center;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0 auto 26px;
  }
</style>
